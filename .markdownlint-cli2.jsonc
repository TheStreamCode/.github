{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": {
      "allowed_elements": ["br", "details", "summary", "img", "p", "a", "div", "kbd", "sup", "sub", "table", "picture", "source"]
    },
    "MD034": false,
    "MD041": true,
    "MD046": { "style": "fenced" },
    "MD048": { "style": "backtick" }
  },
  "ignores": ["node_modules/**", ".git/**"]
}
